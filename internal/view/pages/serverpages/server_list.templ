package serverpages

import (
	"github.com/irgordon/gopanel/internal/view"
	"github.com/irgordon/gopanel/internal/view/pages/containerpages"
)

templ ServerListPage(servers []DisplayServer) {
	@view.Layout("Servers — GoPanel") {
		<main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
			<header class="flex items-center justify-between gap-4">
				<a href="/" class="text-lg font-black tracking-tight text-white">GoPanel</a>
				<a href="/servers/new" hx-get="/servers/new" hx-target="closest main" hx-push-url="true" class="inline-flex min-h-11 items-center rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Add server</a>
			</header>
			<section class="mt-6" aria-labelledby="servers-title" data-request-region="true">
				<h1 id="servers-title" class="text-2xl font-bold text-white">Servers</h1>
				@ServerListFragment(servers)
			</section>
		</main>
	}
}

templ ServerListFragment(servers []DisplayServer) {
	<div data-request-region="true">
		if len(servers) == 0 {
			<div class="mt-6 rounded-3xl border border-white/10 bg-white/[0.045] p-6 text-center">
				<p class="text-sm font-semibold text-slate-300">No servers registered</p>
				<p class="mt-1 text-sm text-slate-500">Add a server to begin managing infrastructure. This list shows validated configuration, not live state.</p>
				<a href="/servers/new" hx-get="/servers/new" hx-target="closest div" hx-push-url="true" class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Add server</a>
			</div>
		} else {
			<ul class="mt-6 space-y-3">
				for _, srv := range servers {
					<li>
						<a href={ templ.URL("/servers/" + srv.ID) } hx-get={ "/servers/" + srv.ID } hx-target="closest section" hx-push-url="true" class="block rounded-2xl border border-white/10 bg-white/[0.045] p-4 hover:bg-white/[0.08]">
							<p class="text-sm font-semibold text-white">{ srv.Name }</p>
							<p class="text-sm text-slate-400">{ srv.Address } · { srv.ConnectionType }</p>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

templ ServerDetailPage(model DetailModel) {
	@view.Layout(model.Server.Name + " — GoPanel") {
		<main class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6">
			<a href="/servers" hx-get="/servers" hx-target="closest main" hx-push-url="true" class="text-sm font-semibold text-cyan-300">← Back to servers</a>
			<div class="mt-4" data-request-region="true">
				@ServerDetailFragment(model)
			</div>
		</main>
	}
}

templ ServerDetailFragment(model DetailModel) {
	<div class="space-y-4" data-request-region="true">
		<article class="rounded-3xl border border-white/10 bg-white/[0.045] p-6">
			<h1 class="text-xl font-bold text-white">{ model.Server.Name }</h1>
			<dl class="mt-4 space-y-2 text-sm">
				<div><dt class="text-slate-400">Address</dt><dd class="text-white">{ model.Server.Address }</dd></div>
				<div><dt class="text-slate-400">Connection type</dt><dd class="text-white">{ model.Server.ConnectionType }</dd></div>
				<div><dt class="text-slate-400">ID</dt><dd class="font-mono text-xs text-slate-500">{ model.Server.ID }</dd></div>
			</dl>
		</article>
		if model.Docker != nil {
			@containerpages.DockerSummary(*model.Docker)
		}
	</div>
}

templ ServerErrorFragment(errorRef string) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-rose-300/25 bg-rose-300/10 p-5 text-rose-50">
		<p class="font-semibold">GoPanel could not complete this action.</p>
		<p class="mt-2 text-sm leading-6 text-rose-100/80">Try again. If the problem continues, see the Error Log.</p>
		<p class="mt-2 font-mono text-xs">Error reference: { errorRef } <a href={ templ.URL("/errors/" + errorRef) } class="underline">See Error Log</a></p>
	</div>
}

templ ServerErrorPage(errorRef string) {
	@view.Layout("Server error — GoPanel") {
		<main class="mx-auto w-full max-w-xl px-4 py-10 sm:px-6">
			@ServerErrorFragment(errorRef)
		</main>
	}
}

templ ServerAuditIncompletePage(srv DisplayServer, errorRef string) {
	@view.Layout("Server audit incomplete — GoPanel") {
		<main class="mx-auto w-full max-w-xl px-4 py-10 sm:px-6">
			@ServerAuditIncompleteFragment(srv, errorRef)
		</main>
	}
}

templ ServerAuditIncompleteFragment(srv DisplayServer, errorRef string) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-amber-300/25 bg-amber-300/10 p-5 text-amber-50">
		<p class="font-semibold">Server created, but audit is incomplete.</p>
		<p class="mt-2 text-sm leading-6">Do not submit the form again. Open the created server, then contact an administrator with the error reference.</p>
		<div class="mt-4 flex flex-wrap gap-3">
			<a href={ templ.URL("/servers/" + srv.ID) } class="inline-flex min-h-11 items-center rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white">Open created server</a>
			<a href={ templ.URL("/errors/" + errorRef) } class="inline-flex min-h-11 items-center rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white">See Error Log</a>
		</div>
		<p class="mt-3 font-mono text-xs">Error reference: { errorRef }</p>
	</div>
}

templ ServerNotFoundFragment(id string) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-amber-300/25 bg-amber-300/10 p-5 text-amber-50">
		<p class="font-semibold">Server not found</p>
		<p class="mt-2 text-sm">No server with that identifier exists.</p>
		<a href="/servers" hx-get="/servers" hx-target="closest div" hx-push-url="true" class="mt-4 inline-flex min-h-11 items-center rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white">Back to servers</a>
	</div>
}

templ ServerNotFoundPage(id string) {
	@view.Layout("Not found — GoPanel") {
		<main class="mx-auto w-full max-w-xl px-4 py-10 sm:px-6">
			@ServerNotFoundFragment(id)
		</main>
	}
}
