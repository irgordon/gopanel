package serverpages

import (
	"github.com/irgordon/gopanel/internal/view"
)

templ ServerFormPage(csrfToken string, input DisplayInput, fieldErrors map[string]string, formError string) {
	@view.Layout("Add server — GoPanel") {
		<main class="mx-auto w-full max-w-xl px-4 py-6 sm:px-6">
			<a href="/servers" hx-get="/servers" hx-target="closest main" hx-push-url="true" class="text-sm font-semibold text-cyan-300">← Back to servers</a>
			<div class="mt-4" data-request-region="true">
				@ServerFormFragment(csrfToken, input, fieldErrors, formError)
			</div>
		</main>
	}
}

templ ServerFormFragment(csrfToken string, input DisplayInput, fieldErrors map[string]string, formError string) {
	<div data-request-region="true" class="rounded-3xl border border-white/10 bg-white/[0.045] p-6">
		<h1 class="text-xl font-bold text-white">Add server</h1>
		<p class="mt-2 text-sm leading-6 text-slate-400">Register server identity and connection type. No remote contact is made on save. Integration credentials are configured only after the owning integration is available.</p>
		if formError != "" {
			<div role="alert" class="mt-4 rounded-2xl border border-rose-300/25 bg-rose-300/10 p-4 text-rose-50">
				<p class="text-sm">{ formError }</p>
			</div>
		}
		<form method="post" action="/servers" hx-post="/servers" hx-target="closest div" hx-swap="outerHTML" class="mt-6 space-y-5">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@view.FormField("name", "Server name", "name", input.Name, "3-64 characters, letters/numbers/spaces/hyphens/dots. Example: prod-caddy", fieldErrors["name"])
			@view.FormField("address", "Address", "address", input.Address, "Hostname or IP without scheme. Example: 10.0.0.12 or caddy.internal", fieldErrors["address"])
			<div>
				<label for="connection_type" class="block text-sm font-semibold text-slate-100">Connection type</label>
				<p id="connection_type-help" class="mt-1 text-sm leading-6 text-slate-400">Choose the managed system type. Example: docker, caddy, vault, kubernetes.</p>
				<select id="connection_type" name="connection_type" aria-describedby="connection_type-help connection_type-error" class="mt-3 min-h-11 w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-base text-white">
					<option value="">Select type</option>
					<option value="docker" selected?={ input.ConnectionType == "docker" }>docker</option>
					<option value="caddy" selected?={ input.ConnectionType == "caddy" }>caddy</option>
					<option value="vault" selected?={ input.ConnectionType == "vault" }>vault</option>
					<option value="kubernetes" selected?={ input.ConnectionType == "kubernetes" }>kubernetes</option>
				</select>
				<p id="connection_type-error" class="mt-2 min-h-6 text-sm font-medium text-rose-300" aria-live="polite">{ fieldErrors["connection_type"] }</p>
			</div>
			@view.Button("Add server")
		</form>
	</div>
}
