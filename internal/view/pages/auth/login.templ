package authpages

import "github.com/irgordon/gopanel/internal/view"

templ LoginPage(csrfToken string, errorMessage string, emailValue string) {
	@view.Layout("Sign in — GoPanel") {
		<main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10 sm:px-6">
			<div class="mb-8 text-center">
				<a href="/" class="text-lg font-black tracking-tight text-white">GoPanel</a>
				<p class="mt-2 text-sm text-slate-400">Sign in to continue</p>
			</div>
			@view.Card() {
				<h1 class="text-2xl font-bold text-white">Sign in</h1>
				<p class="mt-2 text-sm leading-6 text-slate-400">Use your GoPanel email and password. Contact an administrator if you cannot sign in.</p>
				if errorMessage != "" {
					<div class="mt-6 rounded-2xl border border-rose-300/25 bg-rose-300/10 p-4 text-rose-50" role="alert">
						<p class="text-sm font-medium">{ errorMessage }</p>
					</div>
				}
				<form method="post" action="/login" hx-post="/login" hx-target="closest main" hx-swap="outerHTML" class="mt-6 space-y-5">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					@LoginEmailField(emailValue)
					<div>
						<label for="password" class="block text-sm font-semibold text-slate-100">Password</label>
						<p id="password-help" class="mt-1 text-sm leading-6 text-slate-400">Enter your password.</p>
						<input id="password" name="password" type="password" autocomplete="current-password" required aria-describedby="password-help password-error" class="mt-3 min-h-11 w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-base text-white outline-none placeholder:text-slate-600 focus:border-cyan-300 focus:ring-2 focus:ring-cyan-300/20"/>
						<p id="password-error" class="mt-2 min-h-6 text-sm font-medium text-rose-300" aria-live="polite"></p>
					</div>
					@view.Button("Sign in")
				</form>
			}
		</main>
	}
}

templ LoginFragment(csrfToken string, errorMessage string, emailValue string) {
	<div class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10 sm:px-6" data-request-region="true">
		@view.Card() {
			<h1 class="text-2xl font-bold text-white">Sign in</h1>
			if errorMessage != "" {
				<div class="mt-4 rounded-2xl border border-rose-300/25 bg-rose-300/10 p-4 text-rose-50" role="alert">
					<p class="text-sm font-medium">{ errorMessage }</p>
				</div>
			}
			<form method="post" action="/login" hx-post="/login" hx-target="closest div" hx-swap="outerHTML" class="mt-6 space-y-5">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				@LoginEmailField(emailValue)
				<div>
					<label for="password" class="block text-sm font-semibold text-slate-100">Password</label>
					<p id="password-help" class="mt-1 text-sm leading-6 text-slate-400">Enter your password.</p>
					<input id="password" name="password" type="password" autocomplete="current-password" required aria-describedby="password-help" class="mt-3 min-h-11 w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-base text-white"/>
				</div>
				@view.Button("Sign in")
			</form>
		}
	</div>
}

templ LoginEmailField(emailValue string) {
	<div>
		<label for="email" class="block text-sm font-semibold text-slate-100">Email</label>
		<p id="email-help" class="mt-1 text-sm leading-6 text-slate-400">Enter your account email.</p>
		<input id="email" name="email" type="email" value={ emailValue } autocomplete="username" required aria-describedby="email-help" class="mt-3 min-h-11 w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-base text-white"/>
	</div>
}
