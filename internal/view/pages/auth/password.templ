package authpages

import "github.com/irgordon/gopanel/internal/view"

templ PasswordPage(csrfToken string, message string) {
	@view.Layout("Change password — GoPanel") {
		<main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10 sm:px-6">
			@PasswordFragment(csrfToken, message)
		</main>
	}
}

templ PasswordFragment(csrfToken string, message string) {
	<div class="rounded-3xl border border-white/10 bg-white/[0.045] p-6" data-request-region="true">
		<h1 class="text-2xl font-bold text-white">Change password</h1>
		<p class="mt-2 text-sm leading-6 text-slate-400">Changing your password signs out every active session for your account.</p>
		if message != "" {
			<div class="mt-4 rounded-2xl border border-rose-300/25 bg-rose-300/10 p-4 text-rose-50" role="alert">{ message }</div>
		}
		<form method="post" action="/account/password" hx-post="/account/password" hx-target="closest div" hx-swap="outerHTML" class="mt-6 space-y-5">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@PasswordField("current_password", "Current password", "current-password", "Enter your current password.")
			@PasswordField("new_password", "New password", "new-password", "Use between 12 and 1024 characters.")
			@PasswordField("confirm_password", "Confirm new password", "new-password", "Enter the new password again.")
			@view.Button("Change password")
		</form>
	</div>
}

templ PasswordField(name string, label string, autocomplete string, help string) {
	<div>
		<label for={ name } class="block text-sm font-semibold text-slate-100">{ label }</label>
		<p id={ name + "-help" } class="mt-1 text-sm leading-6 text-slate-400">{ help }</p>
		<input id={ name } name={ name } type="password" autocomplete={ autocomplete } required aria-describedby={ name + "-help" } class="mt-3 min-h-11 w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-base text-white"/>
	</div>
}

templ DeniedPage(message string) {
	@view.Layout("Request denied — GoPanel") {
		<main class="mx-auto flex min-h-screen w-full max-w-xl flex-col justify-center px-4 py-10 sm:px-6">
			@DeniedFragment(message)
		</main>
	}
}

templ DeniedFragment(message string) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-amber-300/25 bg-amber-300/10 p-5 text-amber-50">
		<p class="font-semibold">GoPanel could not authorize this request.</p>
		<p class="mt-2 text-sm leading-6">{ message }</p>
		<a href="/login" class="mt-4 inline-flex min-h-11 items-center rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white">Go to sign in</a>
	</div>
}

templ FailurePage(message string, reference string) {
	@view.Layout("GoPanel error") {
		<main class="mx-auto flex min-h-screen w-full max-w-xl flex-col justify-center px-4 py-10 sm:px-6">
			@FailureFragment(message, reference)
		</main>
	}
}

templ FailureFragment(message string, reference string) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-rose-300/25 bg-rose-300/10 p-5 text-rose-50">
		<p class="font-semibold">GoPanel could not complete the request.</p>
		<p class="mt-2 text-sm leading-6">{ message }</p>
		<p class="mt-3 font-mono text-xs">Error reference: { reference }</p>
		<p class="mt-2 text-sm">Contact an administrator if the problem continues.</p>
	</div>
}
