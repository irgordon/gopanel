package containerpages

import "github.com/irgordon/gopanel/internal/view"

templ LogsPage(model LogsModel) {
	@view.Layout("Container logs — GoPanel") {
		<main class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6">
			<a href={ templ.URL("/servers/" + model.ServerID + "/containers") } class="text-sm font-semibold text-cyan-300">← Back to containers</a>
			<section class="mt-5" aria-labelledby="logs-title" data-request-region="true">
				<p class="text-sm font-semibold tracking-wide text-amber-300 uppercase">Administrator only · Last 100 lines</p>
				<h1 id="logs-title" class="mt-2 text-2xl font-bold text-white">Container logs</h1>
				<p class="mt-2 text-sm leading-6 text-slate-400">Logs are untrusted, potentially sensitive application output. GoPanel does not persist or place them in diagnostics.</p>
				<pre class="mt-5 max-h-[70vh] overflow-auto whitespace-pre-wrap break-words rounded-2xl border border-white/10 bg-black/40 p-4 font-mono text-xs leading-6 text-slate-200" tabindex="0">{ model.Content }</pre>
			</section>
		</main>
	}
}

templ DockerErrorPage(model ErrorModel) {
	@view.Layout(model.Title + " — GoPanel") {
		<main class="mx-auto w-full max-w-xl px-4 py-10 sm:px-6">
			@DockerErrorFragment(model)
		</main>
	}
}

templ DockerErrorFragment(model ErrorModel) {
	<div role="alert" data-request-region="true" class="rounded-2xl border border-rose-300/25 bg-rose-300/10 p-5 text-rose-50">
		<h1 class="text-xl font-bold text-white">{ model.Title }</h1>
		<p class="mt-2 text-sm leading-6 text-rose-100/80">{ model.Message }</p>
		if model.ErrorReference != "" {
			<p class="mt-3 font-mono text-xs">Error reference: { model.ErrorReference }
				if model.ShowErrorLog {
					<a href={ templ.URL("/errors/" + model.ErrorReference) } class="underline">See Error Log</a>
				}
			</p>
		}
		<a href={ templ.URL("/servers/" + model.ServerID) } class="mt-4 inline-flex min-h-11 items-center rounded-xl border border-white/15 px-4 py-2 text-sm font-semibold text-white">Back to server</a>
	</div>
}
