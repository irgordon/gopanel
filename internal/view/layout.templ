package view

templ Layout(title string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-950">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="GoPanel Phase 0 application scaffold"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true,"includeIndicatorStyles":false}'/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/output.css"/>
			<script src="/static/htmx-1.9.12.min.js" defer></script>
			<script src="/static/application.js" defer></script>
		</head>
		<body class="min-h-full bg-slate-950 text-slate-100 antialiased selection:bg-cyan-300 selection:text-slate-950">
			{ children... }
		</body>
	</html>
}
